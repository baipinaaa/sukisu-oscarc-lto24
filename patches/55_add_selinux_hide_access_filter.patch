diff --git a/kernel/feature/selinux_hide.c b/kernel/feature/selinux_hide.c
--- a/kernel/feature/selinux_hide.c
+++ b/kernel/feature/selinux_hide.c
@@ -334,6 +334,16 @@
 
     length = -EINVAL;
     if (sscanf(buf, "%s %s %hu", scon, tcon, &tclass) != 3)
+        goto out;
+
+    /*
+     * ReSukiSU: 过滤 root 检测工具的 access 探测查询。
+     * 当 scon/tcon 含 fsck_untrusted / su / adbroot 等敏感上下文关键词时,
+     * 直接返回 -EINVAL (视为非法查询), 避免泄露 fake policy 中的域信息。
+     */
+    if (strstr(scon, "fsck_untrusted") || strstr(tcon, "fsck_untrusted") ||
+        strstr(scon, "adbroot") || strstr(tcon, "adbroot") ||
+        strstr(scon, ":su:") || strstr(tcon, ":su:"))
         goto out;
 
     sconlen = strlen(scon);
