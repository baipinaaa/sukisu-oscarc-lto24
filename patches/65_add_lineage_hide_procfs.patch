 #include <linux/vmalloc.h>
 #include <linux/slab.h>
 #include <linux/cred.h>
@@ -494,6 +495,28 @@
  */
 int seq_file_path(struct seq_file *m, struct file *file, const char *esc)
 {
+	if (lineage_hide_active()) {
+		char *buf;
+		size_t size = seq_get_buf(m, &buf);
+		int res = -1;
+
+		if (size) {
+			char *p = d_path(&file->f_path, buf, size);
+
+			if (!IS_ERR(p)) {
+				char *end;
+
+				lineage_hide_scrub_rom_names(p);
+				end = mangle_path(buf, p, esc);
+				if (end)
+					res = end - buf;
+			}
+		}
+		seq_commit(m, res);
+
+		return res;
+	}
+
 	return seq_path(m, &file->f_path, esc);
 }
 EXPORT_SYMBOL(seq_file_path);
diff -ruN orig/include/linux/lineage_hide.h mod/include/linux/lineage_hide.h
--- orig/include/linux/lineage_hide.h	1970-01-01 08:00:00.000000000 +0800
+++ mod/include/linux/lineage_hide.h	2026-10-25 11:20:39.837191700 +0800
@@ -0,0 +1,44 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Scrub custom ROM identifiers out of path strings that procfs shows to
+ * application processes.  Only the display string is rewritten in place;
+ * file access is not affected.
+ */
+#ifndef _LINUX_LINEAGE_HIDE_H
+#define _LINUX_LINEAGE_HIDE_H
+
+#include <linux/cred.h>
+#include <linux/kernel.h>
+#include <linux/sched.h>
+#include <linux/string.h>
+#include <linux/types.h>
+
+#define LINEAGE_HIDE_APP_UID_MIN 10000
+
+static inline bool lineage_hide_active(void)
+{
+	return current_uid().val >= LINEAGE_HIDE_APP_UID_MIN;
+}
+
+static inline void lineage_hide_scrub_rom_names(char *path)
+{
+	static const char *const rom_names[] = {
+		"lineage", "crdroid", "aospa", "pixelexperience",
+		"omnirom", "protonaosp",
+	};
+	size_t i, len;
+	char *p;
+
+	if (!path || !lineage_hide_active())
+		return;
+
+	for (i = 0; i < ARRAY_SIZE(rom_names); i++) {
+		len = strlen(rom_names[i]);
+		for (p = path; *p; p++) {
+			if (!strncasecmp(p, rom_names[i], len))
+				p[len - 1] = 'x';
+		}
+	}
+}
+
+#endif /* _LINUX_LINEAGE_HIDE_H */
