@@ -498,6 +507,14 @@
             str[size - 1] = 0;
             size--;
         }
+
+        /*
+         * ReSukiSU: 拒绝应用进程把自身切换到 adbroot 特权域。
+         * 与 my_write_context() 保持一致返回 -EINVAL, 让探测方看到
+         * "域不存在", 而不是 "域存在但切换被拒"。
